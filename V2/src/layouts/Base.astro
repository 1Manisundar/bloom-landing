---
// Only the brand-kit weights the page uses: DM Sans 400–700, Fraunces 500/600 (+ italic 500), Syne 700/800.
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-600.css";
import "@fontsource/dm-sans/latin-700.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-500-italic.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/syne/latin-700.css";
import "@fontsource/syne/latin-800.css";
import "../styles/global.css";
// The two faces on the first screen, preloaded (font-display: swap comes from @fontsource).
import frauncesHead from "@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url";
import dmSansBody from "@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url";
import tokens from "../styles/tokens.css?raw";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props { title?: string; description?: string; path?: string; home?: boolean }
const {
  title = "Neuroditto: a fitness tracker for your mind",
  description = "Neuroditto tracks your thinking patterns and blind spots across every part of your life. A phone app for one person.",
  path = "/",
  home = false,
} = Astro.props;
const site = Astro.site ?? new URL("https://neuroditto.ai");
const canonical = new URL(path, site).href;
const ogImage = new URL("/og.png", site).href;
// The browser bar colour starts as ivory (read from tokens.css, the one place colours live); the page
// script keeps it equal to the page colour while it blends.
const ivory = tokens.match(/--c-ivory:\s*(#[0-9A-Fa-f]{6})/)?.[1];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={ivory} id="themeColor" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preload" href={frauncesHead} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansBody} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- PLACEHOLDER icons until the logo file is in the repo (see scripts/brand-assets.mjs). -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Neuroditto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Neuroditto: a fitness tracker for your mind. Professor Hoot, a Neuroditto companion, beside the words." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/page";
    </script>
  </body>
</html>
