---
// PRIVACY PAGE OFF for now (user, Nov 9 2026). Files starting with "_" are not built. Rename back to
// privacy.astro and restore the footer link in src/components/Footer.astro to bring it back.
// /privacy, in two parts. "Your data stays on your phone" describes the app ONLY, never the waitlist.
// Placeholders stay visible until the founders give the facts.
import Base from "../layouts/Base.astro";
const updated = "3 November 2026";
---
<Base
  title="Privacy · Neuroditto"
  description="What the Neuroditto website and waitlist store (your email and sign-up date), who can see it, and how to be removed. In the Neuroditto app, your data stays on your phone."
  path="/privacy"
>
  <section class="sect policy" data-bg="ivory" aria-labelledby="privacy-title">
    <div class="wrap policy__inner">
      <h1 id="privacy-title">Privacy</h1>
      <p class="policy__lead">Two parts: this website with its waitlist, and the Neuroditto app.</p>

      <section class="policy__part" aria-labelledby="part-site">
        <h2 id="part-site">This website and the waitlist</h2>
        <ul class="policy__list" role="list">
          <li>We store your email address and the date you signed up, in <span translate="no">Supabase</span> (<mark class="placeholder">[REGION]</mark>).</li>
          <li>Only the two founders, Jyothi and Krishna, can see it.</li>
          <li>We use it only to email you about <span translate="no">Neuroditto</span>.</li>
          <li>To be removed, email <mark class="placeholder">[CONTACT EMAIL]</mark>.</li>
          <li>This site uses no cookies and no trackers.</li>
        </ul>
      </section>

      <section class="policy__part" aria-labelledby="part-app">
        <h2 id="part-app">The <span translate="no">Neuroditto</span> app</h2>
        <p>Your data stays on your phone.</p>
      </section>

      <p class="note">Last updated {updated}.</p>
      <p><a href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
<style>
  /* Same left edge as the header; the reading column stays 680px. */
  .policy { padding-block: 72px; }
  .policy__inner { display: flex; flex-direction: column; gap: 16px; }
  .policy__inner > * { max-width: 680px; }
  .policy h1 { font: 600 clamp(44px, 6vw, 88px)/.98 var(--font-serif); letter-spacing: -.035em; margin-bottom: 8px; }
  .policy__lead { font-size: var(--fs-lead); color: var(--text-2); margin-bottom: 24px; }
  .policy__part { background: var(--card); border-radius: var(--r-tile); padding: 28px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-ink) 5%, transparent), 0 30px 60px -44px var(--shadow-ink); }
  .policy__part h2 { font: 600 clamp(26px, 3vw, 34px)/1.1 var(--font-serif); letter-spacing: -.02em; }
  .policy__list { display: flex; flex-direction: column; gap: 12px; }
  .policy__list li { position: relative; padding-left: 20px; }
  .policy__list li::before { content: ""; position: absolute; left: 0; top: .65em; width: 7px; height: 7px; border-radius: 50%; background: var(--c-jade); }
  .policy a { color: var(--c-forest); font-weight: 600; }
</style>
