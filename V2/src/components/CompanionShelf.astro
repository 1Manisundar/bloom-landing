---
// 8 companions on lavender cards. Tap a card to show its role and one sample line.
// Built on <details name="shelf">: works without script, and only one card is open at a time.
// All companions here are still files; the only animated companion on the page is Hoot in the hero.
import Companion from "./Companion.astro";
import Icon from "./Icon.astro";
import { SHELF } from "../data/companions";
---
<ul class="shelf" role="list">
  {SHELF.map((c) => (
    <li class="shelf__card">
      <details class="shelf__item" name="shelf">
        <summary class="shelf__summary">
          <span class="shelf__art"><Companion name={c.key} width={150} decorative /></span>
          <span class="shelf__row">
            <span class="shelf__name" translate="no">{c.name}</span>
            <Icon name="plus" size={20} class="shelf__icon" />
          </span>
        </summary>
        <div class="shelf__detail">
          <p class="shelf__role">{c.role}</p>
          <p class="shelf__line">“{c.greeting}”</p>
        </div>
      </details>
    </li>
  ))}
</ul>
<p class="caption shelf__hint">Tap a companion to see how it talks.</p>
<style>
  .shelf { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); align-items: start; }
  .shelf__card {
    background: var(--c-lavender); border-radius: var(--r-card);
    outline: 2px solid transparent; outline-offset: -2px;
    transition: outline-color var(--dur) var(--ease);
  }
  /* Open state: forest outline plus the revealed role (never colour alone). */
  .shelf__card:has(.shelf__item[open]) { outline-color: var(--primary); }
  .shelf__summary {
    display: flex; flex-direction: column; gap: var(--space-1);
    padding: var(--space-3) var(--space-3) var(--space-2);
    cursor: pointer; list-style: none; border-radius: var(--r-card);
  }
  .shelf__summary::-webkit-details-marker { display: none; }
  .shelf__summary:focus-visible { outline-offset: -3px; }
  .shelf__art { display: flex; justify-content: center; }
  .shelf__art :global(.companion) { --companion-w: min(150px, 100%); transition: transform var(--dur) var(--ease); }
  .shelf__summary:hover .shelf__art :global(.companion) { transform: translateY(-4px); }
  .shelf__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-1); min-height: 44px; }
  .shelf__name { font-family: var(--font-sans); font-weight: 700; font-size: var(--fs-lead); line-height: 1.3; }
  .shelf__row :global(.shelf__icon) { flex: none; color: var(--primary); transition: transform var(--dur) var(--ease); }
  .shelf__item[open] .shelf__row :global(.shelf__icon) { transform: rotate(45deg); }

  .shelf__detail { padding: 0 var(--space-3) var(--space-3); display: flex; flex-direction: column; gap: 0.375rem; }
  .shelf__item[open] .shelf__detail { animation: shelf-settle var(--dur-slow) var(--ease); }
  @keyframes shelf-settle { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .shelf__role { font-size: var(--fs-small); color: var(--text-2); font-weight: 600; }
  .shelf__line { font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-body); line-height: 1.5; }
  .shelf__hint { margin-top: var(--space-3); }

  @media (max-width: 960px) { .shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 420px) {
    .shelf { gap: 0.75rem; }
    .shelf__summary { padding: var(--space-2) var(--space-2) var(--space-1); }
    .shelf__detail { padding: 0 var(--space-2) var(--space-2); }
    .shelf__name { font-size: var(--fs-body); }
    .shelf__line { font-size: var(--fs-small); }
  }
</style>
