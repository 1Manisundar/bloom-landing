---
// 8 companions on lavender cards. Phase 1: every card shows its role and sample line.
// Phase 2 turns each card into a button that reveals the role and line on tap.
import Companion from "./Companion.astro";
import { SHELF } from "../data/companions";
---
<ul class="shelf" role="list">
  {SHELF.map((c) => (
    <li class="shelf__card">
      <div class="shelf__art"><Companion name={c.key} width={150} /></div>
      <h3 class="shelf__name">{c.name}</h3>
      <p class="shelf__role">{c.role}</p>
      <p class="shelf__line">“{c.greeting}”</p>
    </li>
  ))}
</ul>
<style>
  .shelf { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); }
  .shelf__card {
    background: var(--c-lavender); border-radius: var(--r-card);
    padding: var(--space-3);
    display: flex; flex-direction: column; gap: 0.375rem;
  }
  .shelf__art { display: flex; justify-content: center; margin-bottom: var(--space-1); }
  .shelf__art :global(.companion) { --companion-w: min(150px, 100%); }
  .shelf__name { font-family: var(--font-sans); font-weight: 700; font-size: var(--fs-lead); line-height: 1.3; }
  .shelf__role { font-size: var(--fs-small); color: var(--text-2); font-weight: 500; }
  .shelf__line { font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-body); line-height: 1.5; margin-top: 0.25rem; }
  @media (max-width: 960px) { .shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 420px) {
    .shelf { gap: 0.75rem; }
    .shelf__card { padding: var(--space-2); }
    .shelf__line { font-size: var(--fs-small); }
  }
</style>
