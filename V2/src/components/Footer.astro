---
import { LINKS } from "../data/content";
const year = 2026;
---
<footer class="foot" id="footer" data-bg="ivory">
  <div class="wrap foot__bar">
    <span>© {year} <span translate="no">Neuroditto.ai</span></span>
    <ul class="foot__links" role="list">
      <li><a href="/privacy">Privacy</a></li>
      <li><a href={LINKS.instagram} rel="me noopener" target="_blank">Instagram<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <!-- PLACEHOLDER: LinkedIn URL not given yet -->
      <li><a href={LINKS.linkedin} data-placeholder="linkedin">LinkedIn</a></li>
    </ul>
  </div>
</footer>
<style>
  .foot { border-top: 1px solid var(--c-border); padding-block: 24px; color: var(--c-eucalyptus); font-size: var(--fs-small); }
  .foot__bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .foot__links { display: flex; gap: 20px; }
  .foot__links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--c-ink); font-weight: 500; }
  .foot__links a:hover { color: var(--c-forest); }
</style>
