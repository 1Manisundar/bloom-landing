---
import Button from "./Button.astro";
import { NAV } from "../data/content";
---
<header class="site-header" data-tone="day">
  <nav class="site-header__bar container" aria-label="Main">
    <!-- PLACEHOLDER: the logo file is not in the repo yet; a text wordmark stands in. -->
    <a class="wordmark" href="/" aria-label="Neuroditto, home" translate="no">Neuroditto</a>
    <ul class="site-header__links" role="list">
      {NAV.map((item) => <li><a class="navlink" href={item.href}>{item.label}</a></li>)}
    </ul>
    <Button href="/#join" size="sm" class="site-header__cta">Join the waitlist</Button>
  </nav>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent; /* taste-skill-ignore: adapter hairline, shown once scrolled */
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  /* Transparent at the top; blur and a hairline once the page scrolls (adapter). */
  .site-header.is-scrolled {
    background: var(--header-bg);
    backdrop-filter: blur(10px); /* taste-skill-ignore: adapter navbar blur */
    -webkit-backdrop-filter: blur(10px); /* taste-skill-ignore: adapter navbar blur */
    border-bottom-color: var(--rule);
  }
  /* Over the night chapter the header switches to the dark tokens. */
  .site-header[data-tone="night"] {
    --text: var(--night-text);
    --primary: var(--night-accent);
    --on-primary: var(--c-emerald);
    --rule: var(--c-dark-card);
    --header-bg: color-mix(in srgb, var(--c-dark-bg) 88%, transparent);
    color: var(--night-text);
  }
  .site-header[data-tone="night"] :global(.btn--primary:hover) { background: var(--c-champagne); border-color: var(--c-champagne); }
  .site-header[data-tone="night"] :focus-visible { outline-color: var(--night-accent); }
  .site-header__bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    min-height: 72px;
    padding-block: 0.75rem;
  }
  .wordmark {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-sans); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.01em;
    color: var(--text); text-decoration: none;
  }
  .site-header__links { display: flex; gap: var(--space-3); }
  .navlink {
    position: relative; display: inline-flex; align-items: center; min-height: 44px;
    color: var(--text); text-decoration: none; font-weight: 500; font-size: var(--fs-small); white-space: nowrap;
  }
  .navlink::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 8px; height: 2px;
    background: var(--primary);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .navlink:hover::after, .navlink:focus-visible::after { transform: scaleX(1); }

  @media (max-width: 860px) {
    .site-header__bar { grid-template-columns: 1fr auto; padding-block: 0.5rem 0.25rem; }
    .site-header__links {
      grid-column: 1 / -1; grid-row: 2;
      gap: 0 var(--space-2);
      justify-content: space-between;
    }
    .navlink { min-height: 40px; }
  }
  @media (max-width: 360px) {
    .site-header__links { flex-wrap: wrap; justify-content: flex-start; }
  }
</style>
