---
import { NAV } from "../data/content";
interface Props { home?: boolean }
const { home = false } = Astro.props;
const href = (hash: string) => (home ? hash : `/${hash}`);
---
<header class="nav" id="nav">
  <div class="nav__in">
    <!-- PLACEHOLDER: the logo file is not in the repo yet; a text wordmark stands in. -->
    <a class="logo" href={home ? "#top" : "/"} aria-label="Neuroditto, home" translate="no"><i aria-hidden="true"></i>Neuroditto</a>
    <nav class="links" aria-label="Main">
      {NAV.map((item) => <a href={href(item.hash)}>{item.label}</a>)}
    </nav>
    <a class="btn nav__cta" href={href("#join")}>Join the waitlist</a>
    <button class="menu" id="menuBtn" type="button" aria-expanded="false" aria-controls="dropMenu" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
    </button>
  </div>
  <nav class="drop" id="dropMenu" aria-label="Main" hidden>
    {NAV.map((item) => <a href={href(item.hash)}>{item.label}</a>)}
  </nav>
</header>
<style>
  .nav {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
    background: color-mix(in srgb, var(--pbg) 90%, transparent);
    color: var(--pfg);
    border-bottom: 1px solid color-mix(in srgb, var(--pfg) 8%, transparent);
    backdrop-filter: blur(14px);
  }
  .nav__in { max-width: var(--container); margin: 0 auto; padding: 14px var(--gr) 14px var(--gl); display: flex; align-items: center; gap: 20px; }
  .logo { font: 600 21px/1 var(--font-serif); text-decoration: none; display: flex; gap: 9px; align-items: center; min-height: 44px; color: var(--pfg); }
  .logo i { width: 10px; height: 10px; border-radius: 50%; background: var(--c-gold); }
  .links { display: flex; gap: 26px; margin-left: auto; }
  .links a { text-decoration: none; font-weight: 500; font-size: var(--fs-small); color: var(--pfg); opacity: .78; transition: opacity .3s; display: inline-flex; align-items: center; min-height: 44px; }
  .links a:hover { opacity: 1; }
  .nav__cta { min-height: 42px; padding: 0 18px; font-size: var(--fs-small); }
  .menu {
    display: none; width: 44px; height: 44px; border-radius: 12px; border: 0; cursor: pointer;
    align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--pfg) 9%, transparent); color: var(--pfg);
  }
  .drop { padding: 0 var(--gr) 12px var(--gl); display: grid; }
  .drop[hidden] { display: none; }
  .drop a { padding: 14px 0; text-decoration: none; font-weight: 600; color: var(--pfg); border-top: 1px solid color-mix(in srgb, var(--pfg) 12%, transparent); }

  @media (max-width: 960px) {
    .links { display: none; }
    .nav__cta { margin-left: auto; min-height: 40px; padding: 0 14px; font-size: 14px; }
    .menu { display: inline-flex; }
  }
  @media (min-width: 961px) { .drop { display: none !important; } }
</style>
