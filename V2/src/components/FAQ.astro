---
import Icon from "./Icon.astro";
import { FAQ } from "../data/content";
// [CURRENT STAGE] stays a visible placeholder until the founders give the line.
const parts = (a: string) => a.split(/(\[CURRENT STAGE\])/);
---
<div class="faq">
  {FAQ.map((item) => (
    <details class="faq__item">
      <summary class="faq__q">
        <span>{item.q}</span>
        <Icon name="plus" size={22} class="faq__icon" />
      </summary>
      <p class="faq__a">
        {parts(item.a).map((p) => p === "[CURRENT STAGE]" ? <mark class="placeholder">[CURRENT STAGE]</mark> : p)}
      </p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 12px; }
  .faq__item {
    background: var(--card); border-radius: var(--r-card);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-ink) 5%, transparent), 0 24px 50px -40px var(--shadow-ink);
  }
  .faq__q {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    min-height: 68px; padding: 16px 24px;
    font: 600 20px/1.3 var(--font-serif); letter-spacing: -.01em;
    cursor: pointer; list-style: none; border-radius: inherit;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--c-forest); }
  .faq__q :global(.faq__icon) { flex: none; color: var(--c-forest); transition: transform .3s var(--glide); }
  .faq__item[open] .faq__q :global(.faq__icon) { transform: rotate(45deg); }
  .faq__a { color: var(--text-2); padding: 0 24px 22px; max-width: 64ch; }
  @media (max-width: 600px) {
    .faq__q { padding: 14px 18px; font-size: 18px; }
    .faq__a { padding: 0 18px 18px; }
  }
</style>
