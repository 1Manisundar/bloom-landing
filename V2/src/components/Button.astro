---
import Icon from "./Icon.astro";
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "secondary";
  size?: "md" | "sm";
  arrow?: boolean;
  id?: string;
  class?: string;
}
const { href, type = "button", variant = "primary", size = "md", arrow = false, id, class: cls = "" } = Astro.props;
const classes = `btn btn--${variant} btn--${size} ${cls}`;
---
{href ? (
  <a class={classes} href={href} id={id}><span><slot /></span>{arrow && <Icon name="arrow-right" size={18} class="btn__arrow" />}</a>
) : (
  <button class={classes} type={type} id={id}><span><slot /></span>{arrow && <Icon name="arrow-right" size={18} class="btn__arrow" />}</button>
)}
<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    min-height: 48px; padding: 0 1.5rem;
    border-radius: var(--r-button);
    font-family: var(--font-sans); font-weight: 600; font-size: var(--fs-body); line-height: 1.3;
    text-decoration: none; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--primary); /* taste-skill-ignore: adapter secondary button = forest 1px outline */
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .btn--sm { min-height: 44px; padding: 0 1.125rem; font-size: var(--fs-small); }
  .btn--primary { background: var(--primary); color: var(--on-primary); }
  .btn--primary:hover { background: var(--c-ink); border-color: var(--c-ink); }
  .btn--secondary { background: transparent; color: var(--primary); }
  .btn--secondary:hover { background: var(--c-sage); }
  .btn:active { transform: translateY(1px); }
  .btn :global(.btn__arrow) { transition: transform var(--dur) var(--ease); }
  .btn:hover :global(.btn__arrow) { transform: translateX(4px); }
</style>
