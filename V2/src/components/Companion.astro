---
// One real companion file from public/companions. Never drawn here.
// Only one `animated` companion may be on screen at a time; everything else uses still files.
import { companion, companionSrc, type Pose } from "../data/companions";
interface Props {
  name: string;
  pose?: Pose;
  animated?: boolean;
  width?: number;
  decorative?: boolean;
  eager?: boolean;
  class?: string;
}
const { name, pose = "front", animated = false, width = 160, decorative = false, eager = false, class: cls = "" } = Astro.props;
const c = companion(name);
const height = Math.round((width * 240) / 200);
---
<img
  class={`companion ${cls}`}
  src={companionSrc(name, pose, animated)}
  alt={decorative ? "" : c.alt}
  width={width}
  height={height}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>
<style>
  .companion { width: var(--companion-w, auto); height: auto; aspect-ratio: 200 / 240; }
</style>
