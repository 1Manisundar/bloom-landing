---
// The signature graphic: one pebble per moment, stacked by week, joined by the gold thread.
// Example data only (from the prototype). Phase 2 drops the pebbles and draws the thread on scroll.
import { WEEKS } from "../data/content";
const RX = [30, 27, 29, 25];
const CY = [248, 224, 201, 178];
const x = (w: number) => 70 + w * 100;
const top = (n: number) => CY[n - 1] - 27;
let d = `M${x(0)} ${top(WEEKS[0])}`;
for (let w = 1; w < WEEKS.length; w++) {
  const x0 = x(w - 1), x1 = x(w), y0 = top(WEEKS[w - 1]), y1 = top(WEEKS[w]);
  d += ` C${x0 + 45} ${y0} ${x1 - 45} ${y1} ${x1} ${y1}`;
}
const last = WEEKS.length - 1;
const words = ["one", "two", "three", "four", "five", "six"];
const label = `Example chart: pebbles for times you jumped, ${words[WEEKS[0] - 1]} in week one falling to ${words[WEEKS[last] - 1]} in week six, joined by a gold thread.`;
---
<svg class="pebbles" viewBox="0 112 640 196" role="img" aria-label={label}>
  <line class="pebbles__ground" x1="30" y1="262" x2="610" y2="262" />
  <g class="pebbles__stones">
    {WEEKS.map((n, w) => Array.from({ length: n }, (_, i) => (
      <ellipse class="pebbles__stone" data-week={w + 1} data-i={i} cx={x(w)} cy={CY[i]} rx={RX[(i + w) % RX.length]} ry={i === 0 ? 12 : 11} />
    )))}
  </g>
  <path class="pebbles__thread" d={d} pathLength="1" />
  <circle class="pebbles__dot" cx={x(last)} cy={top(WEEKS[last])} r="10" />
  <g class="pebbles__weeks" aria-hidden="true">
    {WEEKS.map((_, w) => <text x={x(w)} y="296">Week {w + 1}</text>)}
  </g>
</svg>
<style>
  .pebbles { width: 100%; height: auto; overflow: visible; }
  .pebbles__ground { stroke: var(--rule); stroke-width: 2; }
  .pebbles__stone { fill: var(--primary); }
  .pebbles__thread { fill: none; stroke: var(--c-gold); stroke-width: 4; stroke-linecap: round; }
  .pebbles__dot { fill: var(--c-gold); }
  .pebbles__weeks text { font-family: var(--font-sans); font-size: 16px; fill: var(--text-2); text-anchor: middle; }
  @media (max-width: 600px) { .pebbles__weeks text { font-size: 26px; } }
</style>
