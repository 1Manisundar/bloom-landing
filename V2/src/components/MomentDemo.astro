---
// The hero demo. Three fixed example moments; the visitor never types and nothing is sent.
// Frame 0 is complete: moment 1 with its reaction and companion line, nothing waiting to animate in.
// With script: the dots switch moments; with motion allowed it plays through the three once, typing
// each moment, then stops. A pause button is always there. Reduced motion: no autoplay, instant switch.
import Companion from "./Companion.astro";
import Icon from "./Icon.astro";
import { MOMENTS } from "../data/content";
const first = MOMENTS[0];
---
<figure class="demo" aria-labelledby="demo-title" data-moments={JSON.stringify(MOMENTS)}>
  <div class="demo__panel">
    <div class="demo__head">
      <span class="demo__today">Today</span>
      <span class="demo__flag" id="demo-title">Example moments</span>
    </div>

    <div class="demo__live" data-demo="live" aria-live="off">
    <p class="demo__moment"><span class="visually-hidden">Example moment: <span data-demo="text-sr">{first.text}</span></span><span data-demo="text" aria-hidden="true">{first.text}</span></p>

    <div class="demo__react">
      <span class="demo__react-label">How you reacted</span>
      <span class="demo__tag" data-demo="tag">{first.tag}</span>
    </div>

    <div class="demo__speaks">
      <Companion name="hoot" pose="discovering" animated width={128} eager class="demo__hoot" />
      <p class="demo__line"><span class="visually-hidden">Professor Hoot says: </span><span data-demo="line">{first.line}</span></p>
    </div>
    </div>

    <div class="demo__pips" aria-hidden="true" data-demo="static-pips">
      {MOMENTS.map((_, i) => <span class:list={["demo__pip", { "is-on": i === 0 }]} />)}
    </div>
    <div class="demo__controls" data-demo="controls" hidden>
      <div class="demo__dots" role="group" aria-label="Example moments">
        {MOMENTS.map((m, i) => (
          <button class="demo__dot" type="button" data-demo-go={i} aria-pressed={i === 0 ? "true" : "false"} aria-label={`Example ${i + 1} of ${MOMENTS.length}: ${m.tag}`}>
            <span class:list={["demo__pip", { "is-on": i === 0 }]} />
          </button>
        ))}
      </div>
      <button class="demo__pause" type="button" data-demo="pause" aria-label="Pause the animation">
        <span data-icon="pause"><Icon name="pause" size={18} /></span>
        <span data-icon="play" hidden><Icon name="play" size={18} /></span>
      </button>
    </div>
  </div>
  <figcaption class="caption demo__caption">One of three example moments, written to show the idea.</figcaption>
</figure>

<style>
  .demo { width: 100%; max-width: 30rem; margin-inline: auto; }
  .demo__panel {
    background: var(--c-sage);
    border-radius: var(--r-panel);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .demo__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); }
  .demo__today { font-family: var(--font-serif); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; }
  .demo__flag {
    font-family: var(--font-accent); font-weight: 600; font-size: var(--fs-label);
    letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--accent-text);
  }
  .demo__moment {
    align-self: flex-end; max-width: 88%;
    background: var(--primary); color: var(--on-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--r-card) var(--r-card) 6px var(--r-card);
    font-size: var(--fs-body); line-height: 1.45;
  }
  .demo__react {
    background: var(--c-ivory); border-radius: var(--r-card);
    padding: 0.875rem 1rem;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap;
  }
  .demo__react-label { font-size: var(--fs-small); font-weight: 500; color: var(--text-2); }
  .demo__tag {
    font-family: var(--font-accent); font-weight: 700; font-size: var(--fs-body);
    color: var(--primary);
    padding: 0.25rem 0.875rem; border-radius: var(--r-round);
    border: 1.5px solid var(--primary);
  }
  .demo__speaks { display: flex; align-items: flex-end; gap: 0.25rem; margin-top: var(--space-1); }
  .demo__speaks :global(.demo__hoot) { --companion-w: 7.5rem; flex: none; margin-left: -0.5rem; margin-bottom: -0.5rem; }
  .demo__line {
    flex: 1; min-width: 0;
    background: var(--c-lavender);
    padding: 0.875rem 1rem;
    border-radius: var(--r-card) var(--r-card) var(--r-card) 6px;
    font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-body); line-height: 1.5;
    margin-bottom: 2.5rem;
  }
  .demo__pips { display: flex; justify-content: center; gap: 6px; }
  .demo__pips[hidden] { display: none; }
  .demo__pip { width: 8px; height: 8px; border-radius: var(--r-round); background: var(--c-jade); opacity: 0.45; }
  .demo__pip.is-on { width: 24px; background: var(--primary); opacity: 1; }
  .demo__caption { margin-top: var(--space-2); text-align: center; }
  .demo__live { display: flex; flex-direction: column; gap: inherit; }

  .demo__controls { display: flex; align-items: center; justify-content: center; gap: var(--space-1); }
  .demo__controls[hidden] { display: none; }
  .demo__dots { display: flex; }
  .demo__dot, .demo__pause {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; padding: 0;
    background: transparent; border: 0; border-radius: var(--r-button); cursor: pointer;
  }
  .demo__dot { min-width: 32px; }
  .demo__dot:hover .demo__pip:not(.is-on) { opacity: 0.8; }
  .demo__pip { transition: width var(--dur) var(--ease), background-color var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .demo__pause { color: var(--primary); }
  .demo__pause:hover { background: var(--c-ivory); }
  .demo__pause [hidden] { display: none; }

  /* Reaction and companion line settle in after the moment is typed. */
  .demo__tag, .demo__line { transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease); }
  .demo.is-typing .demo__tag, .demo.is-typing .demo__line,
  .demo .is-waiting { opacity: 0; transform: translateY(6px); }
  @media (max-width: 600px) {
    .demo__panel { gap: 0.75rem; padding: 1rem 1rem 0.875rem; }
    .demo__speaks :global(.demo__hoot) { --companion-w: 6rem; }
    .demo__line { margin-bottom: 1.75rem; }
    .demo__controls { margin-top: -0.5rem; }
  }
</style>
<script>
  import { startDemo } from "../scripts/demo";
  startDemo();
</script>
