---
// Front: the pattern word and what it means. Back: an example line.
// Without script both faces show (the Phase 1 layout). With script the card turns:
// a crossfade with a small settle (no 3D spin, which the brand rules out).
import Companion from "./Companion.astro";
import type { Pose } from "../data/companions";
interface Props { word: string; body: string; example: string; companion: string; pose: Pose }
const { word, body, example, companion, pose } = Astro.props;
const id = `pcard-${word.toLowerCase().replace(/\s+/g, "-")}`;
---
<li class="pcard" data-pcard data-reveal>
  <div class="pcard__faces">
    <div class="pcard__face pcard__front" id={`${id}-front`}>
      <div class="pcard__art"><Companion name={companion} pose={pose} width={132} decorative /></div>
      <h3 class="pcard__word">{word}</h3>
      <p class="pcard__body">{body}</p>
    </div>
    <div class="pcard__face pcard__back" id={`${id}-back`}>
      <span class="pcard__ex"><span class="pcard__ex-word">{word}</span> · Example</span>
      <p class="pcard__example">“{example}”</p>
    </div>
  </div>
  <button class="pcard__turn" type="button" aria-expanded="false" aria-controls={`${id}-back`} hidden>
    <span data-label-front>See an example</span><span data-label-back hidden>Back to {word.toLowerCase()}</span>
  </button>
</li>
<style>
  .pcard {
    background: var(--c-mist);
    border-radius: var(--r-panel);
    padding: clamp(1.5rem, 2.5vw, 2rem);
    display: flex; flex-direction: column; gap: var(--space-3);
    container-type: inline-size;
  }
  .pcard__faces { display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
  .pcard__face { display: flex; flex-direction: column; gap: 0.75rem; }
  .pcard__art { height: 168px; display: flex; align-items: flex-end; }
  .pcard__art :global(.companion) { --companion-w: 132px; }
  .pcard__word {
    font-family: var(--font-accent); font-weight: 800;
    /* Sized to its card: "Hesitate" in Syne 800 is about 6.1em wide, so 15cqi always fits. */
    font-size: min(var(--fs-pattern), 15cqi); line-height: 1.05; letter-spacing: -0.01em;
    color: var(--primary);
  }
  .pcard__body { color: var(--text); }
  .pcard__back { border-top: var(--hairline); padding-top: var(--space-3); margin-top: auto; }
  .pcard__ex { font-size: var(--fs-caption); font-weight: 600; color: var(--text-2); }
  .pcard__ex-word { display: none; }
  .pcard__example { font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-lead); line-height: 1.45; color: var(--text); }

  .pcard__turn {
    align-self: flex-start;
    display: inline-flex; align-items: center; min-height: 44px;
    padding: 0 1.125rem; border-radius: var(--r-button);
    background: transparent; color: var(--primary);
    border: 1px solid var(--primary); /* taste-skill-ignore: adapter secondary button = forest 1px outline */
    font-weight: 600; font-size: var(--fs-small); cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }
  .pcard__turn:hover { background: var(--c-ivory); }
  .pcard__turn [hidden] { display: none; }

  /* ---- Turning card (script adds .is-turnable) ---- */
  /* The face on show sets the card's height; the other is lifted out of the flow while it fades. */
  .pcard.is-turnable .pcard__faces { display: block; position: relative; }
  .pcard.is-turnable .pcard__face { position: relative; transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease), visibility 0s linear var(--dur-slow); }
  .pcard.is-turnable:not(.is-turned) .pcard__back,
  .pcard.is-turned .pcard__front { position: absolute; top: 0; left: 0; right: 0; }
  .pcard.is-turnable .pcard__back {
    border-top: 0; padding-top: 0; margin-top: 0; gap: var(--space-2);
    opacity: 0; transform: translateY(12px); visibility: hidden;
  }
  .pcard.is-turnable .pcard__ex-word {
    display: inline;
    font-family: var(--font-accent); font-weight: 700; color: var(--primary);
  }
  .pcard.is-turnable .pcard__example { font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.35; }
  .pcard.is-turned .pcard__front { opacity: 0; transform: translateY(-12px); visibility: hidden; }
  .pcard.is-turned .pcard__back { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }
  .pcard.is-turned .pcard__front, .pcard:not(.is-turned) .pcard__back { pointer-events: none; }
  .pcard.is-turnable:not(.is-turned) .pcard__front, .pcard.is-turned .pcard__back { transition-delay: 0s; }
</style>
<script>
  for (const card of document.querySelectorAll<HTMLElement>("[data-pcard]")) {
    const button = card.querySelector<HTMLButtonElement>(".pcard__turn");
    if (!button) continue;
    const front = button.querySelector<HTMLElement>("[data-label-front]");
    const back = button.querySelector<HTMLElement>("[data-label-back]");
    card.classList.add("is-turnable");
    button.hidden = false;
    const faces = card.querySelector<HTMLElement>(".pcard__faces");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    button.addEventListener("click", () => {
      const from = faces?.offsetHeight ?? 0;
      const turned = card.classList.toggle("is-turned");
      const to = faces?.offsetHeight ?? 0;
      // Ease the card to its new height (400ms, brand easing); instant with reduced motion.
      if (faces && from !== to && !reduce.matches) {
        faces.style.overflow = "hidden";
        faces.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 400, easing: "cubic-bezier(0.22, 1, 0.36, 1)" })
          .finished.finally(() => { faces.style.overflow = ""; });
      }
      button.setAttribute("aria-expanded", String(turned));
      if (front) front.hidden = turned;
      if (back) back.hidden = !turned;
    });
  }
</script>
