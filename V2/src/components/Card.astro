---
// A filled, flat surface. Tints go on cards, never on full-width bands.
interface Props {
  tint?: "sage" | "mist" | "lavender" | "blush" | "oat" | "ivory";
  size?: "card" | "panel";
  as?: "div" | "article" | "li" | "figure";
  class?: string;
}
const { tint = "sage", size = "card", as: Tag = "div", class: cls = "" } = Astro.props;
---
<Tag class={`card card--${size} ${cls}`} style={`--card-bg: var(--c-${tint})`}><slot /></Tag>
<style>
  .card { background: var(--card-bg); border-radius: var(--r-card); padding: var(--space-3); }
  .card--panel { border-radius: var(--r-panel); padding: clamp(1.5rem, 3vw, 2.5rem); }
</style>
