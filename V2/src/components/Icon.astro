---
// Lucide icons (2px stroke), inlined from lucide-static at build time. Decorative unless `label` is given.
// Lucide has no brand icons, so Instagram and LinkedIn come from Tabler Icons (same 2px outline style).
import plus from "lucide-static/icons/plus.svg?raw";
import externalLink from "lucide-static/icons/external-link.svg?raw";
import instagram from "@tabler/icons/outline/brand-instagram.svg?raw";
import linkedin from "@tabler/icons/outline/brand-linkedin.svg?raw";

const ICONS = { plus, "external-link": externalLink, instagram, linkedin } as const;
interface Props { name: keyof typeof ICONS; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: cls = "" } = Astro.props;
const svg = ICONS[name]
  .replace(/<!--[\s\S]*?-->/, "")
  .replace(/\swidth="24"/, ` width="${size}"`)
  .replace(/\sheight="24"/, ` height="${size}"`)
  .replace(/class="([^"]*)"/, `class="$1 icon ${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`);
---
<Fragment set:html={svg} />
