---
import SectionLabel from "../components/SectionLabel.astro";
import PatternCard from "../components/PatternCard.astro";
import { PATTERNS } from "../data/content";
---
<section class="section patterns" id="patterns" aria-labelledby="patterns-title">
  <div class="container">
    <div class="patterns__head">
      <SectionLabel>What it notices</SectionLabel>
      <h2 id="patterns-title">Where you jump. Where you hesitate. Where you’re sure and wrong.</h2>
    </div>
    <ul class="patterns__grid" role="list">
      {PATTERNS.map((p) => <PatternCard {...p} />)}
    </ul>
    <p class="caption patterns__note">Example lines, written to show the idea.</p>
  </div>
</section>
<style>
  .patterns__head { display: flex; flex-direction: column; gap: var(--space-2); max-width: 52rem; margin-bottom: var(--space-5); }
  .patterns__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .patterns__note { margin-top: var(--space-3); }
  @media (max-width: 960px) { .patterns__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (min-width: 600px) and (max-width: 960px) {
    .patterns__grid :global(.pcard) { display: grid; grid-template-columns: 8rem minmax(0, 1fr); column-gap: var(--space-4); row-gap: 0.75rem; align-items: start; }
    .patterns__grid :global(.pcard__front) { display: contents; }
    .patterns__grid :global(.pcard__art) { grid-column: 1; grid-row: 1 / span 3; height: auto; }
    .patterns__grid :global(.pcard__word), .patterns__grid :global(.pcard__body), .patterns__grid :global(.pcard__back) { grid-column: 2; }
  }
</style>
