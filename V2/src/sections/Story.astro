---
// One phone, four chapters. Two layouts from the same markup:
//  - pinned (script on, motion allowed, screen at least 600px tall): the stage sticks, the four
//    chapters sit on top of each other, and scroll progress cross-fades them (src/scripts/story.ts).
//  - stacked (reduced motion, short screens, no script): each chapter with its own phone, final state.
import { CHAPTERS, FELT, YEAR, MONTH_TICKS, AREAS, AREA_LINKS, CHAIN, STRIP } from "../data/content";
import { companionSrc } from "../data/companions";

// Life map geometry (viewBox 280 × 270), same as the reference page.
const cx = 140, cy = 132, R = 100;
const pos = AREAS.map((_, i) => {
  const t = -Math.PI / 2 + (i * Math.PI * 2) / AREAS.length;
  return [+(cx + R * Math.cos(t)).toFixed(2), +(cy + R * Math.sin(t)).toFixed(2)];
});
const links = AREA_LINKS.map(([a, b, w]) => ({ d: `M${pos[a][0]} ${pos[a][1]} Q${cx} ${cy} ${pos[b][0]} ${pos[b][1]}`, w }));
---
<section class="st" id="story" aria-label="How it works">
  {CHAPTERS.map((c, i) => <i class="st-mark" data-bg={c.bg} data-pin-mark style={`top:${i * 25}%`}></i>)}
  <div class="st-stage" id="stStage">
    {CHAPTERS.map((c, i) => (
      <article class="st-ch" data-i={i} data-bg={c.bg} data-stack-mark>
        <div class="st-txt">
          <span class="st-n">{c.n}</span>
          <h2>{c.title}</h2>
          <p>{c.body}</p>
        </div>
        <div class="st-dev">
          <div class="phone" aria-hidden="true">
            <div class="screen">
              {i === 0 && (
                <div class="scr s0">
                  <p class="k">Tuesday · morning</p>
                  <p class="hi">Good morning, Alex</p>
                  <div class="bub">It’s one of your deep-work mornings. What will you work on from 9 to 11?<span class="chips"><b>Your goal</b><b>Calendar · clear till 11:30</b></span></div>
                  <img class="mira" src={companionSrc("mira", "waving", true)} data-still={companionSrc("mira", "waving")} width="158" height="190" alt="" fetchpriority="low" />
                  <div class="dock">
                    <span class="o">+</span>
                    <span class="o big"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg></span>
                    <span class="o"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M4 5h16v11H8l-4 4z" /></svg></span>
                  </div>
                </div>
              )}
              {i === 1 && (
                <div class="scr s1">
                  <p class="k">Your moments</p>
                  <p class="ttl">Your year, in moments</p>
                  <div class="cairns">
                    {YEAR.map((m) => <div>{m.map((f) => <i class="peb" style={`background:var(--c-${FELT[f].token})`}></i>)}</div>)}
                  </div>
                  <div class="months">{MONTH_TICKS.map((m) => <span>{m}</span>)}</div>
                  <div class="legend">{FELT.map((f) => <span><i style={`background:var(--c-${f.token})`}></i>{f.label}</span>)}</div>
                  <div class="mcard"><q>Diwali at Ma’s with Priya. Loud, warm, too many sweets.</q><small>Nov 8 · felt wonderful</small></div>
                </div>
              )}
              {i === 2 && (
                <div class="scr s2">
                  <p class="k">Your life map</p>
                  <p class="ttl">All of your life, area by area</p>
                  <svg class="map" viewBox="0 0 280 270">
                    {links.map((l) => <path class="map__link" d={l.d} stroke-width={l.w} pathLength="1" />)}
                    {AREAS.map(([name, w], k) => (
                      <g class="map__node" style={`transform-origin:${pos[k][0]}px ${pos[k][1]}px`}>
                        <circle class:list={["map__dot", { "map__dot--key": k === 0 }]} cx={pos[k][0]} cy={pos[k][1]} r={13 + w * 1.6} />
                        <text x={pos[k][0]} y={pos[k][1] + 3.5} text-anchor="middle">{name}</text>
                      </g>
                    ))}
                    <circle class="map__you" cx={cx} cy={cy} r="26" />
                    <text class="map__you-t" x={cx} y={cy + 4.5} text-anchor="middle">You</text>
                  </svg>
                  <div class="mcard"><b>Work and Partner come up together when launch weeks run late.</b><small>3 times · Your moments · Calendar</small></div>
                </div>
              )}
              {i === 3 && (
                <div class="scr s3">
                  <p class="k">Your patterns</p>
                  <p class="ttl">What you tend to do</p>
                  <ol class="chain">
                    {CHAIN.map((c) => <li><small>{c.k}</small>{"thought" in c ? <em>{c.text}</em> : c.text}</li>)}
                  </ol>
                  <div class="strip">{STRIP.map((yes) => <i class:list={{ no: !yes }}></i>)}</div>
                  <p class="cnt">4 times it happened · 1 time it didn’t</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
    <div class="st-dots" aria-hidden="true">{CHAPTERS.map(() => <i></i>)}</div>
    <p class="st-note">Design preview. Example person, example data.</p>
  </div>
</section>

<style>
  /* ---------- shared: phone and screens ---------- */
  .st { position: relative; --s: 1; }
  .st-mark { position: absolute; left: 0; width: 1px; height: 1px; display: none; }
  .st-n { font: 700 13px/1 var(--font-accent); letter-spacing: .18em; color: var(--accent-text); }
  .st-txt { display: grid; align-content: center; gap: 18px; }
  .st-txt h2 { font: 600 var(--fs-story)/1 var(--font-serif); letter-spacing: -.035em; }
  .st-txt p { font-size: clamp(17px, 1.5vw, 21px); color: var(--text-2); max-width: 30ch; }
  .st-dev { display: grid; justify-items: center; align-content: center; min-height: 0; min-width: 0; }
  .st-note { font-size: 12px; color: var(--text-2); text-align: center; }

  /* Designed at 320 × 660; --s scales it to the space it has (set by the story script). */
  .phone {
    width: 320px; height: 660px; flex: none;
    border-radius: 52px; padding: 11px;
    background: var(--phone-frame);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-emerald) 25%, transparent), 0 60px 100px -40px color-mix(in srgb, var(--c-emerald) 55%, transparent), 0 0 0 9px color-mix(in srgb, var(--c-white) 45%, transparent);
    transform: scale(var(--s)); transform-origin: center;
    margin: calc(-330px * (1 - var(--s))) calc(-160px * (1 - var(--s)));
  }
  .screen { position: relative; width: 100%; height: 100%; border-radius: 42px; overflow: hidden; background: var(--c-ivory); }
  .scr { position: absolute; inset: 0; padding: 30px 18px 18px; display: flex; flex-direction: column; gap: 10px; color: var(--c-ink); }
  .k { font: 700 10px/1 var(--font-accent); letter-spacing: .14em; text-transform: uppercase; color: var(--c-bronze); text-align: center; }
  .ttl { font: 600 21px/1.15 var(--font-serif); letter-spacing: -.02em; text-align: center; margin-bottom: 4px; }

  .s0 { background: radial-gradient(70% 40% at 50% 66%, color-mix(in srgb, var(--c-light-gold) 40%, transparent), transparent 70%), linear-gradient(180deg, var(--c-champagne) 0%, var(--c-ivory) 60%); }
  .hi { font: 600 24px/1.1 var(--font-serif); text-align: center; letter-spacing: -.02em; }
  .bub { position: relative; background: var(--card); border-radius: 20px; padding: 12px 14px; font-size: 14.5px; line-height: 1.4; box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--c-emerald) 40%, transparent); display: grid; gap: 8px; margin-top: 6px; }
  .bub::after { content: ""; position: absolute; left: 50%; bottom: -7px; width: 14px; height: 14px; background: var(--card); transform: translateX(-50%) rotate(45deg); border-radius: 3px; }
  .chips { display: flex; gap: 5px; flex-wrap: wrap; }
  .chips b { font: 700 10px/1 var(--font-sans); background: var(--c-champagne); color: var(--c-bronze); padding: 5px 8px; border-radius: 999px; }
  .mira { width: 158px; height: 190px; align-self: center; margin-top: 8px; }
  .dock { margin-top: auto; display: flex; justify-content: center; align-items: center; gap: 22px; background: var(--card); border-radius: 22px; padding: 12px; box-shadow: 0 8px 20px -12px color-mix(in srgb, var(--c-emerald) 30%, transparent); }
  .o { width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid var(--c-border); display: grid; place-items: center; font: 500 24px/1 var(--font-sans); color: var(--c-ink); }
  .o.big { width: 62px; height: 62px; border: 0; background: var(--c-forest); color: var(--c-white); box-shadow: 0 0 0 5px var(--c-sage); }

  .cairns { display: grid; grid-template-columns: repeat(12, 1fr); align-items: end; gap: 3px; height: 200px; padding: 0 4px; border-bottom: 1.5px dashed var(--c-border); }
  .cairns div { display: flex; flex-direction: column-reverse; align-items: center; gap: 2px; }
  .peb { display: block; width: 17px; height: 11px; border-radius: 50%; }
  .peb:nth-child(even) { width: 15px; margin-left: 3px; }
  .months { display: flex; justify-content: space-between; font-size: 10px; color: var(--c-eucalyptus); padding: 0 4px; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 10px; justify-content: center; font-size: 10.5px; color: var(--c-eucalyptus); margin-top: 6px; }
  .legend span { display: inline-flex; align-items: center; gap: 4px; }
  .legend i { width: 8px; height: 8px; border-radius: 50%; }
  .mcard { margin-top: auto; background: var(--card); border-radius: 18px; padding: 12px 14px; display: grid; gap: 6px; box-shadow: 0 8px 20px -14px color-mix(in srgb, var(--c-emerald) 35%, transparent); }
  .mcard q, .mcard b { font: 500 15px/1.35 var(--font-serif); quotes: none; }
  .mcard small { font-size: 11px; color: var(--c-eucalyptus); }

  .map { width: 100%; height: auto; }
  .map text { font: 600 9.5px var(--font-sans); fill: var(--c-ink); }
  .map__link { fill: none; stroke: var(--c-gold); stroke-linecap: round; opacity: .85; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .map__dot { fill: var(--c-white); stroke: var(--c-border); stroke-width: 1.5; }
  .map__dot--key { fill: var(--c-champagne); }
  .map__you { fill: var(--c-forest); }
  .map .map__you-t { font: 600 13px var(--font-serif); fill: var(--c-white); }

  .chain { list-style: none; margin: 6px 0 0; padding: 0 0 0 22px; display: grid; gap: 12px; position: relative; --th: 1; }
  .chain::before { content: ""; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(var(--c-light-gold), var(--c-gold)); transform-origin: top; transform: scaleY(var(--th)); }
  .chain li { position: relative; background: var(--card); border-radius: 16px; padding: 10px 12px; font-size: 14px; line-height: 1.35; box-shadow: 0 8px 18px -14px color-mix(in srgb, var(--c-emerald) 35%, transparent); display: grid; gap: 3px; }
  .chain li::before { content: ""; position: absolute; left: -21px; top: 14px; width: 10px; height: 10px; border-radius: 50%; background: var(--c-gold); box-shadow: 0 0 0 3px var(--c-champagne); }
  .chain small { font: 700 9.5px/1 var(--font-accent); letter-spacing: .12em; text-transform: uppercase; color: var(--c-bronze); }
  .chain em { font: italic 500 15px/1.35 var(--font-serif); }
  .strip { margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; background: var(--card); border-radius: 16px; position: relative; }
  .strip::before { content: ""; position: absolute; left: 18px; right: 18px; top: 50%; height: 1.5px; background: var(--c-border); }
  .strip i { position: relative; width: 14px; height: 14px; border-radius: 50%; background: var(--c-gold); }
  .strip i.no { background: var(--c-white); box-shadow: inset 0 0 0 2px var(--c-jade); }
  .cnt { font-size: 11.5px; color: var(--c-eucalyptus); text-align: center; }

  /* ---------- stacked (default): every chapter in its final state ---------- */
  .st-stage { max-width: var(--container); margin: 0 auto; padding: 40px var(--gr) 32px var(--gl); display: grid; gap: 96px; }
  .st-ch { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 40px; }
  .st-dots { display: none; }
  @media (max-width: 860px) {
    .st-stage { gap: 72px; padding-bottom: 24px; }
    .st-ch { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .st-txt { text-align: center; justify-items: center; gap: 10px; }
    .st-txt h2 { font-size: 34px; }
    .st-txt p { font-size: 15.5px; max-width: 34ch; }
    .st-n { display: none; }
  }

  /* ---------- pinned: one phone on screen, its screen changes ---------- */
  @media (prefers-reduced-motion: no-preference) and (min-height: 600px) {
    :global(html.js) .st { height: 460vh; }
    :global(html.js) .st-mark { display: block; }
    :global(html.js) .st-stage {
      position: sticky; top: var(--navh);
      height: calc(100vh - var(--navh)); height: calc(100svh - var(--navh));
      padding: 0 var(--gr) 0 var(--gl);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: "copy dev" "copy note";
      align-items: center; gap: 0 40px;
    }
    :global(html.js) .st-ch { display: contents; }
    :global(html.js) .st-txt { grid-area: copy; align-self: center; min-height: 320px; position: relative; z-index: 1; }
    :global(html.js) .st-dev { grid-area: dev; height: 100%; }
    :global(html.js) .st-note { grid-area: note; padding: 6px 0 10px; }
    :global(html.js) .st-dots { grid-area: copy; align-self: center; justify-self: start; display: flex; gap: 8px; translate: 0 200px; }
    :global(html.js) .st-dots i { width: 8px; height: 8px; border-radius: 999px; background: color-mix(in srgb, var(--pfg) 18%, transparent); transition: transform .5s var(--glide); }
    :global(html.js) .st-dots i:global(.on) { background: var(--c-forest); transform: scaleX(1.6); margin-inline: 4px; }
    /* The four phones sit exactly on top of each other: only the first draws the frame. */
    :global(html.js) .st-ch + .st-ch .phone { background: transparent; box-shadow: none; }
    :global(html.js) .st-ch + .st-ch .screen { background: transparent; }
    :global(html.js) .st-ch + .st-ch .st-txt, :global(html.js) .st-ch + .st-ch .scr { opacity: 0; }
    .st-txt, .scr { will-change: opacity, transform; }
  }
  @media (prefers-reduced-motion: no-preference) and (min-height: 600px) and (max-width: 860px) {
    :global(html.js) .st { height: 420vh; }
    :global(html.js) .st-stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas: "copy" "dev" "note";
      padding-top: 18px; gap: 6px; align-items: stretch;
    }
    :global(html.js) .st-txt { min-height: 150px; align-self: start; align-content: start; gap: 8px; }
    :global(html.js) .st-dots { display: none; }
    :global(html.js) .st-dev { align-content: start; }
  }
</style>

<script>
  import "../scripts/story";
</script>
