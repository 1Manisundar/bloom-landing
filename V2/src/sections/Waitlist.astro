---
import WaitlistForm from "../components/WaitlistForm.astro";
import GoldThread from "../components/GoldThread.astro";
---
<section class="section join" id="join" aria-labelledby="join-title">
  <div class="container join__inner">
    <GoldThread class="join__thread" />
    <h2 class="join__title" id="join-title">See how you think.</h2>
    <p class="join__lead">Join the waitlist. We’ll write when there’s something to try.</p>
    <WaitlistForm />
  </div>
</section>
<style>
  .join__inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-3); }
  .join__inner :global(.join__thread) { width: 7rem; }
  .join__title { font-size: var(--fs-h2-why); line-height: 1.06; }
  .join__lead { font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); max-width: 34ch; }
</style>
