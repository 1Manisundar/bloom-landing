---
import WaitlistForm from "../components/WaitlistForm.astro";
import { JOIN_FACES, companionSrc } from "../data/companions";
---
<section class="sect" id="join" data-bg="ivory" aria-labelledby="join-h">
  <div class="wrap">
    <div class="joinbox rise">
      <div class="faces2" aria-hidden="true">
        {JOIN_FACES.map((c) => <img src={companionSrc(c.key, "waving")} width="72" height="86" alt="" loading="lazy" decoding="async" />)}
      </div>
      <h2 class="h2" id="join-h">See how you <em>think.</em></h2>
      <p class="lead">Join the waitlist. We’ll write when there’s something to try.</p>
      <WaitlistForm />
    </div>
  </div>
</section>
<style>
  .joinbox {
    background: linear-gradient(180deg, var(--c-sage), color-mix(in srgb, var(--c-sage) 50%, var(--c-ivory)));
    border-radius: 40px; padding: 72px 24px;
    text-align: center; display: grid; justify-items: center; gap: 18px;
  }
  .faces2 { display: flex; margin-bottom: 6px; }
  .faces2 img { width: 72px; height: auto; margin-inline: -8px; }
  @media (max-width: 600px) { .joinbox { border-radius: 30px; padding: 56px 18px; } }
</style>
