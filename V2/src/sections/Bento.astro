---
import { BENTO_FACES, TINTS, companionSrc } from "../data/companions";
---
<section class="sect" id="inside" data-bg="ivory" aria-labelledby="b-h">
  <div class="wrap">
    <div class="center rise"><h2 class="h2 h2--big" id="b-h">Small app.<br /><em>Whole picture.</em></h2></div>
    <div class="bento">
      <div class="bx b-today rise">
        <p class="bk">Today</p>
        <h3>One small step, every morning.</h3>
        <div class="tcard"><small>Your step today</small><b>Keep 9 to 11 for deep work</b><span class="cal" aria-hidden="true"><i class="g"></i><i></i><i></i><i></i></span></div>
      </div>
      <div class="bx b-clear rise">
        <p class="bk">Something stuck?</p>
        <h3>Clear one thought.</h3>
        <div class="clr">
          <p class="th">“I always mess up launches.”<small>Your reading, not a fact yet</small></p>
          <span class="ar" aria-hidden="true">↓</span>
          <p class="stp"><small>One small step</small>List what went right last time.</p>
        </div>
        <p class="dim">About 4 minutes, one question at a time.</p>
      </div>
      <div class="bx b-grow rise">
        <p class="bk">Becoming</p>
        <h3>Goals that grow.</h3>
        <div class="plants">
          <span><svg viewBox="0 0 40 40" aria-hidden="true"><ellipse class="f-bronze" cx="20" cy="33" rx="7" ry="4" /></svg>Seed</span>
          <span><svg viewBox="0 0 40 40" aria-hidden="true"><path class="stem" d="M20 34V22" /><path class="f-jade" d="M20 23c-6 0-9-4-9-8 5 0 9 3 9 8z" /></svg>Sprout</span>
          <span><svg viewBox="0 0 40 40" aria-hidden="true"><path class="stem" d="M20 34V14" /><path class="f-jade" d="M20 24c-7 0-10-4-10-9 6 0 10 3 10 9zM20 18c6 0 9-4 9-9-6 0-9 3-9 9z" /></svg>Leaves</span>
          <span><svg viewBox="0 0 40 40" aria-hidden="true"><path class="stem" d="M20 34V16" /><path class="f-jade" d="M20 26c-6 0-9-3-9-7 5 0 9 2 9 7z" /><circle class="f-lgold" cx="20" cy="11" r="7" /><circle class="f-gold" cx="20" cy="11" r="3" /></svg>Bloom</span>
        </div>
      </div>
      <div class="bx b-src rise">
        <p class="bk">Honest by design</p>
        <h3>Everything shows where it came from.</h3>
        <div class="srcs"><b>You said</b><b>Calendar · read only</b><b>Your moments</b><b class="nq">Not quite? Tap to remove</b></div>
      </div>
      <div class="bx b-comp rise">
        <p class="bk">Companions</p>
        <h3>30 ways to talk it through.</h3>
        <div class="faces3">
          {BENTO_FACES.map((c, i) => (
            <span style={`--tint:var(--c-${TINTS[i % TINTS.length]})`}><img src={companionSrc(c.key)} width="58" height="70" alt={c.alt} loading="lazy" decoding="async" /></span>
          ))}
        </div>
      </div>
    </div>
    <p class="note b-note">Screens use an example person and example data.</p>
  </div>
</section>
<style>
  .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; }
  .bx {
    background: var(--card); border-radius: var(--r-tile); padding: 30px;
    display: grid; gap: 14px; align-content: start; overflow: hidden;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-ink) 5%, transparent), 0 30px 60px -44px var(--shadow-ink);
  }
  .bx h3 { font: 600 var(--fs-tile)/1.08 var(--font-serif); letter-spacing: -.025em; }
  .bk { font: 700 11px/1 var(--font-accent); letter-spacing: .16em; text-transform: uppercase; color: var(--c-bronze); }

  .b-today { grid-column: span 4; background: linear-gradient(160deg, var(--c-champagne), var(--c-ivory) 70%); }
  .tcard { background: var(--card); border-radius: 22px; padding: 18px; display: grid; gap: 6px; max-width: 420px; box-shadow: 0 14px 30px -20px color-mix(in srgb, var(--c-emerald) 40%, transparent); }
  .tcard small { font: 700 10px/1 var(--font-accent); letter-spacing: .12em; text-transform: uppercase; color: var(--c-bronze); }
  .tcard b { font: 600 20px/1.2 var(--font-serif); }
  .cal { display: flex; gap: 6px; margin-top: 6px; }
  .cal i { height: 10px; flex: 1; border-radius: 999px; background: var(--c-sage); }
  .cal i.g { flex: 2; background: var(--c-gold); }

  .b-clear { grid-column: span 2; background: var(--c-emerald); color: var(--c-dark-text); }
  .b-clear .bk { color: var(--c-light-gold); }
  .clr { display: grid; gap: 8px; justify-items: start; }
  .clr .th { font: italic 500 18px/1.3 var(--font-serif); border: 1.5px dashed color-mix(in srgb, var(--c-dark-text) 35%, transparent); border-radius: 18px; padding: 12px 14px; display: grid; gap: 6px; }
  .clr small { font: 700 9.5px/1 var(--font-accent); letter-spacing: .12em; text-transform: uppercase; color: var(--c-dark-text-2); font-style: normal; }
  .clr .ar { color: var(--c-light-gold); font-size: 20px; line-height: 1; margin-left: 16px; }
  .clr .stp { background: var(--c-light-gold); color: var(--c-emerald); border-radius: 18px; padding: 12px 14px; font: 600 16px/1.3 var(--font-sans); display: grid; gap: 6px; }
  .clr .stp small { color: var(--c-bronze); }
  .dim { color: var(--c-dark-text-2); }

  .b-grow { grid-column: span 3; background: var(--c-sage); }
  .plants { display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; }
  .plants span { display: grid; justify-items: center; gap: 6px; font-size: 13px; color: var(--c-eucalyptus); }
  .plants svg { width: 56px; height: 56px; background: var(--card); border-radius: 18px; padding: 6px; }
  .stem { stroke: var(--c-forest); stroke-width: 3; stroke-linecap: round; fill: none; }
  .f-jade { fill: var(--c-jade); } .f-bronze { fill: var(--c-bronze); } .f-gold { fill: var(--c-gold); } .f-lgold { fill: var(--c-light-gold); }

  .b-src { grid-column: span 3; background: var(--c-lavender); }
  .srcs { display: flex; flex-wrap: wrap; gap: 8px; }
  .srcs b { font: 700 13px/1 var(--font-sans); background: var(--card); color: var(--c-ink); padding: 10px 14px; border-radius: 999px; }
  .srcs b.nq { background: transparent; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--c-ink) 20%, transparent); color: var(--c-eucalyptus); }

  .b-comp { grid-column: span 6; grid-template-columns: 1fr auto; align-items: center; background: var(--c-blush); }
  .b-comp .bk, .b-comp h3 { grid-column: 1; }
  .faces3 { grid-column: 2; grid-row: 1 / 3; display: flex; padding-left: 12px; }
  .faces3 span { width: 70px; height: 70px; border-radius: 22px; display: grid; place-items: center; margin-left: -12px; background: color-mix(in srgb, var(--tint) 70%, var(--c-white)); box-shadow: 0 0 0 4px var(--c-blush); }
  .faces3 img { width: 58px; height: 58px; }
  .b-note { text-align: center; margin-top: 20px; }

  @media (max-width: 860px) {
    .bento { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .bx { grid-column: auto !important; padding: 24px; border-radius: 26px; }
    .b-comp { grid-template-columns: minmax(0, 1fr); }
    .faces3 { grid-column: 1; grid-row: auto; }
  }
  @media (max-width: 400px) {
    .faces3 span { width: 60px; height: 60px; border-radius: 19px; }
    .faces3 img { width: 50px; height: 50px; }
  }
</style>
