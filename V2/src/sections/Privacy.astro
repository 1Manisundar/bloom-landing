---
// PLACEHOLDER: the three privacy lines are waiting for founder confirmation. Do not make them stronger.
import { PRIVACY_LINES } from "../data/content";
---
<section class="priv dark" id="privacy" data-bg="emerald" data-fg="dark-text" aria-labelledby="pv-h">
  <div class="wrap">
    <div class="pv-lock rise" aria-hidden="true">
      <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
    </div>
    <h2 class="pv-h rise" id="pv-h">Your mind stays<br /><em>on your phone.</em></h2>
    <div class="pv-grid">
      {PRIVACY_LINES.map((l) => <div class="rise"><b>{l.title}</b><p>{l.body}</p></div>)}
    </div>
  </div>
</section>
<style>
  .priv { padding-block: 80px; text-align: center; }
  .pv-lock { display: grid; place-items: center; margin-bottom: 26px; color: var(--c-light-gold); }
  .pv-h { font: 600 var(--fs-privacy)/.98 var(--font-serif); letter-spacing: -.04em; }
  .pv-h em { font-style: italic; font-weight: 500; color: var(--c-light-gold); }
  .pv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; max-width: 980px; margin: 64px auto 0; text-align: left; }
  .pv-grid b { font: 600 22px/1.2 var(--font-serif); display: block; margin-bottom: 8px; }
  .pv-grid p { color: var(--c-dark-text-2); }
  @media (max-width: 860px) {
    .priv { padding-block: 56px; }
    .pv-grid { grid-template-columns: minmax(0, 1fr); gap: 26px; margin-top: 44px; }
  }
</style>
