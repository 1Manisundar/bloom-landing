---
// Founders + FAQ: the current words, restyled (ivory, big Fraunces headings, white rounded cards).
import FAQ from "../components/FAQ.astro";
import { FOUNDERS, LINKS } from "../data/content";
// FOUNDERS OFF for now (user, Nov 9 2026): set to true to show the founders block above the FAQ again.
const SHOW_FOUNDERS = false;
---
<section class="sect founders" id="founders" data-bg="ivory" aria-labelledby={SHOW_FOUNDERS ? "founders-h" : "faq-h"}>
  <div class="wrap">
    {SHOW_FOUNDERS && (<>
    <div class="center rise">
      <p class="eyebrow">The founders</p>
      <h2 class="h2" id="founders-h">Built in public by Jyothi and Krishna.</h2>
      <p class="lead">We share what we build, what we learn and what goes wrong. Follow along.</p>
      <a class="btn btn--soft" href={LINKS.instagram} rel="noopener" target="_blank">@neuroditto.ai on Instagram<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
    <ul class="people" role="list">
      {FOUNDERS.map((f) => (
        <li class="person rise">
          <!-- PLACEHOLDER: founder photo -->
          <div class="person__photo" role="img" aria-label={`Photo placeholder for ${f.name}`}>Photo</div>
          <div>
            <p class="person__name">{f.name}</p>
            <p class="person__role">{f.role}</p>
          </div>
        </li>
      ))}
    </ul>
    </>)}

    <div class:list={["faq-block", { "faq-block--first": !SHOW_FOUNDERS }]}>
      <h2 class="h2 faq-h rise" id="faq-h">Questions people ask us</h2>
      <div class="rise"><FAQ /></div>
    </div>
  </div>
</section>
<style>
  .people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; max-width: 760px; margin: 0 auto; }
  .person {
    background: var(--card); border-radius: var(--r-tile); padding: 24px;
    display: flex; align-items: center; gap: 16px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-ink) 5%, transparent), 0 30px 60px -44px var(--shadow-ink);
  }
  .person__photo {
    width: 72px; height: 72px; border-radius: 50%; flex: none;
    background: var(--c-blush); border: 2px dashed var(--c-jade);
    display: grid; place-items: center; font-size: var(--fs-note); color: var(--text-2);
  }
  .person__name { font: 600 24px/1.1 var(--font-serif); letter-spacing: -.02em; }
  .person__role { font-size: var(--fs-small); color: var(--text-2); margin-top: 4px; }
  .faq-block { margin-top: 96px; display: grid; justify-items: center; gap: 40px; }
  .faq-block--first { margin-top: 0 !important; }
  .faq-h { text-align: center; }
  .faq-block > div { width: 100%; max-width: 820px; }
  @media (max-width: 600px) {
    .people { grid-template-columns: minmax(0, 1fr); }
    .faq-block { margin-top: 64px; gap: 28px; }
  }
</style>
