---
import SectionLabel from "../components/SectionLabel.astro";
import { STEPS } from "../data/content";
---
<section class="section how" id="how" aria-labelledby="how-title">
  <div class="container how__grid" data-reveal-group>
    <div class="how__label" data-reveal><SectionLabel>How it works</SectionLabel></div>
    <h2 class="how__title" id="how-title" data-reveal><span data-dim>A fitness tracker doesn’t walk for you.</span> It shows you how you move.</h2>
    <p class="how__lead" data-reveal>Neuroditto doesn’t think for you. It shows you how you think.</p>
    <ol class="steps">
      {STEPS.map((s, i) => (
        <li class="step" data-reveal data-rule>
          <svg class="step__mark" viewBox="0 0 64 40" aria-hidden="true" focusable="false">
            {i === 0 && <path class="stone stone--forest" d="M6 24 C6 14 22 9 34 10 C48 11 60 16 58 26 C56 34 44 37 30 36 C16 35 6 32 6 24 Z" />}
            {i === 1 && <>
              <path class="stone stone--jade" d="M4 26 C4 16 18 12 30 13 C44 14 58 18 58 27 C58 34 46 36 32 36 C16 36 4 33 4 26 Z" />
              <path class="stone stone--forest" d="M14 13 C14 6 24 3 32 4 C42 5 48 8 47 13 C46 18 38 19 30 19 C20 19 14 17 14 13 Z" />
            </>}
            {i === 2 && <>
              <path class="stone stone--jade" d="M4 30 C4 24 16 21 30 22 C44 23 58 25 58 31 C58 36 46 38 32 38 C16 38 4 36 4 30 Z" />
              <path class="stone stone--forest" d="M12 19 C12 14 22 12 31 12 C42 12 50 14 50 19 C50 23 42 24 31 24 C20 24 12 23 12 19 Z" />
              <circle class="stone--gold" cx="33" cy="6" r="5" />
            </>}
          </svg>
          <span class="step__n" aria-hidden="true">{String(i + 1).padStart(2, "0") /* taste-skill-ignore: prototype step numbers */}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .how__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    column-gap: var(--space-5);
    row-gap: var(--space-4);
  }
  .how__label { grid-column: 1; grid-row: 1; padding-top: 0.6rem; }
  .how__title { grid-column: 2; grid-row: 1; max-width: 26ch; }
  .how__lead { grid-column: 1; grid-row: 2; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); max-width: 22ch; }
  .steps { grid-column: 2; grid-row: 2; }
  .step {
    display: grid;
    grid-template-columns: 64px 2.5rem minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    position: relative;
  }
  /* Hairline as a pseudo-element so it can extend across on scroll (rule-extend). */
  .step::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; /* taste-skill-ignore: adapter hairline (rule-extend) */
    background: var(--rule);
    transform: scaleX(var(--rule-x, 1)); transform-origin: left;
  }
  .step:last-child { border-bottom: var(--hairline); }
  .step__mark { width: 64px; height: 40px; align-self: center; }
  .stone--forest { fill: var(--primary); }
  .stone--jade { fill: var(--c-jade); }
  .stone--gold { fill: var(--c-gold); }
  .step__n { font-family: var(--font-accent); font-weight: 800; font-size: var(--fs-small); color: var(--accent-text); }
  .step__title { font-size: var(--fs-h3); line-height: 1.3; }
  .step__body { color: var(--text-2); }

  @media (max-width: 900px) {
    .how__grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
    .how__label, .how__title, .how__lead, .steps { grid-column: 1; grid-row: auto; }
    .how__label { padding-top: 0; }
    .how__title { max-width: none; }
    .how__lead { max-width: 34ch; margin-bottom: var(--space-3); }
    .step { grid-template-columns: 64px minmax(0, 1fr); row-gap: 0.25rem; column-gap: var(--space-2); }
    .step__mark { grid-row: 1 / span 3; align-self: start; }
    .step__n, .step__title, .step__body { grid-column: 2; }
  }
</style>
