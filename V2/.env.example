# Copy to .env (never committed) for local development. On Vercel, set these in
# Settings > Environment Variables instead. Full steps: SETUP-WAITLIST.md

# Where the form posts. Leave empty to keep the list closed: the form then says
# "The list isn't open yet. Nothing was sent." and sends nothing.
PUBLIC_WAITLIST_URL=

# Server only. Never prefix these with PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
